<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty name="enableThreadLocal" source="logging.enableThreadLocal" defaultValue="true"/>

    <!-- condition must precede if; the condition attribute is no longer evaluated -->
    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>enableThreadLocal</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <include resource="com/alilitech/log/base.xml"/>
        </then>
        <else>
            <include resource="org/springframework/boot/logging/logback/base.xml"/>
        </else>
    </if>

</configuration>

